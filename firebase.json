  "hosting": [
    {
      "site": "paychek-trading",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/admin-hub.html",
          "destination": "/admin-hub",
          "type": 301
